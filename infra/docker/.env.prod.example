# Production secrets for infra/docker/compose.prod.yml. Copy to .env.prod on the
# worker VM (never commit it) — or have your secret manager render it at deploy.
# Shared by the backend and both worker roles; see docs/deployment.md.

IMAGE_TAG=latest

# --- Data (managed services) ---
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_DRIVER=s3
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ASSETS=sitereel-assets
R2_BUCKET_RENDERS=sitereel-renders

# --- Web app ---
WEB_ORIGIN=https://app.example.com
WEB_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
# Shared with the web app (worker -> web email endpoint).
INTERNAL_API_SECRET=
# HMAC secret for upload tokens (>= 16 chars).
UPLOAD_TOKEN_SECRET=

# --- AI providers ---
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PRIMARY=gemini
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=info

# --- Abuse controls ---
MAX_ACTIVE_JOBS_PER_USER=2
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=240
RATE_LIMIT_JOB_CREATE_PER_HOUR=20
DOMAIN_THROTTLE_MAX=10
DOMAIN_THROTTLE_WINDOW_SEC=600

# --- Phase 7: retention + alerts ---
# Crawl screenshots, uploads and render work files are deleted this many days after a job ends.
RETENTION_CRAWL_DAYS=30
# Slack/Discord-compatible incoming webhook for ops alerts.
ALERT_WEBHOOK_URL=
ALERT_MIN_SUCCESS_RATE=0.9
ALERT_MAX_QUEUE_WAIT_SEC=300
# Expected AI + TTS cost per video in USD (alert above 2x). 0 = cost alert off.
ALERT_COST_BASELINE_USD=0.12

# --- Rendering ---
# Parallel browsers per render. Leave unset to use half the container's cores.
RENDER_CONCURRENCY=
