{
  "name": "@sitereel/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "render": "tsx src/cli.ts render",
    "purity": "tsx src/cli.ts purity",
    "test": "vitest run"
  },
  "dependencies": {
    "@sitereel/film-runtime": "workspace:*",
    "@sitereel/shared": "workspace:*",
    "playwright": "1.63.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pngjs": "^6.0.5",
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
