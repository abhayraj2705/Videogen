# Local Postgres, managed by `supabase start` (packages/db migrations run against this)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Redis, from infra/docker/compose.yml
REDIS_URL=redis://127.0.0.1:6379

# Local Supabase — run `pnpm supabase:status` to confirm these match your machine
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# MinIO, from infra/docker/compose.yml — stands in for R2 locally (§7.1)
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=sitereel
R2_SECRET_ACCESS_KEY=sitereel-dev-secret
R2_BUCKET_ASSETS=sitereel-assets
R2_BUCKET_RENDERS=sitereel-renders

PORT=8787
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# "local" (default) writes crawl/voice/render artifacts to disk under
# STORAGE_LOCAL_DIR — no R2/MinIO needed for local dev. Set to "s3" + the R2_*
# vars above once assets need to be servable to a browser.
#
# Use an ABSOLUTE path, identical in apps/backend/.env too — both processes
# must agree on the same directory. A relative path resolves against each
# process's own cwd, so "./.data/storage" silently means two different
# directories for backend vs worker (backend then 404s on every render it
# didn't itself write).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/absolute/path/to/sitereel/.data/storage

# Optional. Unset means SiteBrief (Phase 2), planning (Phase 3) and voice
# (Phase 4) all use their deterministic, zero-cost fallbacks instead of
# calling an LLM/TTS API — the pipeline runs end to end either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional local-dev LLM via any OpenAI-compatible endpoint, e.g. WebAI-to-API
# (`poetry run python src/run.py`, then log in at POST /v1/auth/login).
# Takes precedence over GEMINI_API_KEY for SiteBrief + planning; no TTS.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=gemini-3-flash
OPENAI_COMPAT_API_KEY=

# Optional: DeepSeek's API (https://platform.deepseek.com). Text only — no TTS.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Which provider runs SiteBrief + planning: auto | openai-compat | deepseek | gemini.
# auto = first configured of openai-compat, deepseek, gemini. The next
# configured one is the escalation provider when ANTHROPIC_API_KEY is unset.
LLM_PRIMARY=auto

# Optional escalation provider (Phase 3) — only called after the primary
# provider's own retries are exhausted.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: path to ffmpeg.exe if it's not on PATH or in a winget install
# (see packages/shared/src/ffmpeg.ts for the full resolution order).
FFMPEG_PATH=

# Phase 6: worker -> web transactional email (POST {WEB_URL}/api/internal/email
# with header x-internal-secret). Unset INTERNAL_API_SECRET = emails skipped.
# WEB_URL defaults to WEB_ORIGIN. Must match apps/web INTERNAL_API_SECRET.
WEB_URL=http://localhost:3000
INTERNAL_API_SECRET=

# Phase 6 account deletion uses SUPABASE_SERVICE_ROLE_KEY (above) to delete the
# Supabase auth user (GoTrue admin API at SUPABASE_URL).

# Brand webfonts for renders are fetched once from Google Fonts and cached in storage
# (assets/fonts/). Set to "off" on air-gapped hosts; films then use system fonts.
SITEREEL_WEBFONTS=

# --- Phase 7 ---
# Which queues this process serves: all (local dev) | general | render.
WORKER_ROLE=all
# Days after a job ends before its crawl screenshots, uploads and render work files are deleted. 0 = never.
RETENTION_CRAWL_DAYS=30
# Slack/Discord-compatible webhook for ops alerts (success rate, queue wait, cost). Blank = log only.
ALERT_WEBHOOK_URL=
ALERT_MIN_SUCCESS_RATE=0.9
ALERT_MAX_QUEUE_WAIT_SEC=300
# Expected AI + TTS cost per video in USD; alert above 2x. 0 = off.
ALERT_COST_BASELINE_USD=0
# clamd host for scanning user uploads. Blank = uploads are not scanned.
CLAMAV_HOST=
CLAMAV_PORT=3310
