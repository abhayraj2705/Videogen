# Local Postgres, managed by `supabase start` (packages/db migrations run against this)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Redis, from infra/docker/compose.yml
REDIS_URL=redis://127.0.0.1:6379

# Local Supabase — run `pnpm supabase:status` to confirm these match your machine
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# MinIO, from infra/docker/compose.yml — stands in for R2 locally (§7.1)
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=sitereel
R2_SECRET_ACCESS_KEY=sitereel-dev-secret
R2_BUCKET_ASSETS=sitereel-assets
R2_BUCKET_RENDERS=sitereel-renders

PORT=8787
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# "local" (default) writes crawl/voice/render artifacts to disk under
# STORAGE_LOCAL_DIR — no R2/MinIO needed for local dev. Set to "s3" + the R2_*
# vars above once assets need to be servable to a browser.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage

# Optional. Unset means SiteBrief (Phase 2), planning (Phase 3) and voice
# (Phase 4) all use their deterministic, zero-cost fallbacks instead of
# calling an LLM/TTS API — the pipeline runs end to end either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional escalation provider (Phase 3) — only called after the primary
# provider's own retries are exhausted.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: path to ffmpeg.exe if it's not on PATH or in a winget install
# (see packages/shared/src/ffmpeg.ts for the full resolution order).
FFMPEG_PATH=
