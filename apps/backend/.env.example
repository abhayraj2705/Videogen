# Local Postgres, managed by `supabase start` (packages/db migrations run against this)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Redis, from infra/docker/compose.yml
REDIS_URL=redis://127.0.0.1:6379

# Local Supabase — run `pnpm supabase:status` to confirm these match your machine
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# MinIO, from infra/docker/compose.yml — stands in for R2 locally (§7.1)
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=sitereel
R2_SECRET_ACCESS_KEY=sitereel-dev-secret
R2_BUCKET_ASSETS=sitereel-assets
R2_BUCKET_RENDERS=sitereel-renders

PORT=8787
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Must be the exact same absolute path as apps/worker/.env.example's
# STORAGE_LOCAL_DIR — see the comment there.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/absolute/path/to/sitereel/.data/storage

# --- Observability --- Sentry is enabled only when SENTRY_DSN is set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# --- Abuse controls (§8.1) ---
# true when behind a proxy/LB so per-IP limits see the real client IP (X-Forwarded-For).
TRUST_PROXY=false
# Max jobs per user in processing states (review/needs_input do not count). Over → 429.
MAX_ACTIVE_JOBS_PER_USER=2
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=240
RATE_LIMIT_JOB_CREATE_PER_HOUR=20
# Job creations per target domain (across all users) per window.
DOMAIN_THROTTLE_MAX=10
DOMAIN_THROTTLE_WINDOW_SEC=600

# --- Uploads (W8 needs-input, W10 brand-kit logos) ---
# Public base URL of this API as browsers see it. With STORAGE_DRIVER=local,
# presigned upload URLs point at ${API_PUBLIC_URL}/api/uploads/local/:token.
# Defaults to http://localhost:$PORT.
API_PUBLIC_URL=
# HMAC secret for local-driver upload tokens (>= 16 chars). Defaults to a key
# derived from SUPABASE_SERVICE_ROLE_KEY.
UPLOAD_TOKEN_SECRET=

# --- Billing (W11) --- A provider with missing keys answers checkout with
# 503 billing_unavailable. Use test-mode keys locally.
# Stripe (USD): secret key + webhook signing secret (`stripe listen --forward-to localhost:8787/api/webhooks/stripe`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (INR): API key pair + webhook secret (Dashboard → Webhooks → /api/webhooks/razorpay;
# events: payment.captured, order.paid, payment.failed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SSE reconnect/replay buffer (per job, in Redis) ---
SSE_REPLAY_MAX_EVENTS=500
SSE_REPLAY_TTL_SEC=86400
